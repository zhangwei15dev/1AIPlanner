{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "sourceMap": true,
    "lib": ["es2019", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/": ["./src/"]
    }
  },
  "include": ["src", "types", "config"],
  "compileOnSave": false
}
